const { height: ScreenHeight, width: ScreenWidth } = Dimensions.get("window");

// Debounce util
const debounce = (func: any, wait: number) => {
  let timeout: NodeJS.Timeout;
  return (...args: any) => {
    clearTimeout(timeout);
    timeout = setTimeout(() => func.apply(this, args), wait);
  };
};

interface ReelCardProps {
  video_id: number;
  uri: string;
  _id: string | number;
  index: number;
  title?: string;
  description?: string;
  category?: string;
  category_id?:number;
  backgroundColor?: string;
  isActive: boolean;
  stats?: any;
  thumbnail?: string | null;
  onFinishPlaying?: (index: number) => void;
  onComment?: () => void;
  onShare: () => void;
  onPressCategory?: (categoryId: number) => void;  // ✅ new
}

const ReelCard: React.FC<ReelCardProps> = memo(
  ({
    video_id,
    uri,
    _id,
    index,
    title = "Sample Reel",
    description = "This is a sample description for the reel.",
    category = "General",
    category_id,
    backgroundColor = "black",
    isActive,
    stats,
    thumbnail,
    onFinishPlaying = () => { },
    onComment,
    onShare,
    onPressCategory,
  }) => {
    const videoPlayerRef = useRef<Video>(null);
    const [progress, setProgress] = useState(0);
    const [duration, setDuration] = useState(0);
    const [expanded, setExpanded] = useState(false);
    const [reportVisible, setReportVisible] = useState(false);
    const [videoError, setVideoError] = useState(false);
    const [isBuffering, setIsBuffering] = useState(false);
    const [isReady, setIsReady] = useState(false);
    const [cachedUri, setCachedUri] = useState<string | null>(null);
    const [isMuted, setIsMuted] = useState(true); // start muted
    const [showMuteIcon, setShowMuteIcon] = useState(false);
    const [isPaused, setIsPaused] = useState(false); // Track pause/play state
    const [showPlayPauseIcon, setShowPlayPauseIcon] = useState(false); // S
    const singleTapTimeout = useRef<NodeJS.Timeout | null>(null);


    // Ref to store the like function from InteractionRow
    const likeActionRef = useRef<(() => void) | null>(null);

    const isFocused = useIsFocused();
    const { data } = useOnboarding();
    const lastTap = useRef<number | null>(null);



    // Toggle mute/unmute
    const handleToggleMute = () => {
      setIsMuted((prev) => !prev);
      setShowMuteIcon(true);
      setTimeout(() => setShowMuteIcon(false), 1200);
    };


    // Toggle play/pause
    const handleTogglePlayPause = () => {
      setIsPaused((prev) => !prev);
      setShowPlayPauseIcon(true); // Show icon briefly
      setTimeout(() => setShowPlayPauseIcon(false), 1200);
    };

    // Call the stored like action function
    const handleDoubleTap = () => {

      // TODO: trigger like animation here
      likeActionRef.current?.();
    };

    const handleTap = () => {
  const now = Date.now();

  if (lastTap.current && now - lastTap.current < 300) {
    // Double tap detected — like the video
    clearTimeout(singleTapTimeout.current);
    handleDoubleTap();
    lastTap.current = null;
  } else {
    lastTap.current = now;

    // Delay single-tap action (so it won’t trigger if a second tap comes)
    singleTapTimeout.current = setTimeout(() => {
      handleTogglePlayPause(); // single tap toggles play/pause
      lastTap.current = null;
    }, 300);
  }
};

useEffect(() => {
  return () => {
    if (singleTapTimeout.current) clearTimeout(singleTapTimeout.current);
  };
}, []);


    // Format stats
    const formattedStats = React.useMemo(
      () => ({
        likes_count: Number(stats?.likes_count || 0),
        comments_count: Number(stats?.comments_count || 0),
        dislikes_count: Number(stats?.dislikes_count || 0),
        shares_count: Number(stats?.shares_count || 0),
        views_count: Number(stats?.views_count || 0),
        saves_count: Number(stats?.saves_count || 0),
      }),
      [stats]
    );

    // Stream videos; avoid on-disk caching to keep storage usage low
    useEffect(() => {
      let mounted = true;
      async function cleanupAnyPreviousCache() {
        try {
          if (typeof uri !== "string" || !uri) return;
          const cachesPath = (RNFS as any)?.CachesDirectoryPath;
          if (!cachesPath) return;
          const urlWithoutQuery = uri.split("?")[0];
          const fileName =
            urlWithoutQuery.substring(urlWithoutQuery.lastIndexOf("/") + 1) ||
            `video_${video_id}.mp4`;
          const path = `${cachesPath}/${fileName}`;
          const exists = await RNFS.exists(path);
          if (exists) {
            await RNFS.unlink(path).catch(() => { });
          }
          if (mounted) setCachedUri(null);
        } catch (err) { }
      }
      cleanupAnyPreviousCache();
      return () => {
        mounted = false;
      };
    }, [uri, video_id]);

    // Reset when not active
    useEffect(() => {
      if (!isActive && videoPlayerRef.current) {
        videoPlayerRef.current.seek(0);
        setProgress(0);
      }
    }, [isActive]);

    const handleProgress = useCallback(
      debounce((data: any) => {
        setProgress(data.currentTime);
      }, 100),
      []
    );

    const handleVideoError = (error: any) => {
      console.error("❌ Video error:", video_id, error);
      setVideoError(true);
      setTimeout(() => {
        if (isActive) onFinishPlaying(index);
      }, 2000);
    };

    const handleVideoLoad = (data: any) => {
      setDuration(data.duration);
      setIsReady(true);
      setVideoError(false);
    };

    // For non-active items, always render a lightweight thumbnail only.
    if (!isActive) {
      return (
        <View style={[styles.container, { backgroundColor }]}>
          <Image
            source={{ uri: thumbnail || "https://placehold.co/600x800" }}
            style={styles.video}
            resizeMode="cover"
          />
        </View>
      );
    }

    return (
      <View style={[styles.container, { backgroundColor }]}>
        {/* 🎥 Video */}
        {!videoError && Boolean(cachedUri || uri) ? (
          <Video
            ref={videoPlayerRef}
            source={{ uri: (cachedUri || uri) as string }}
            style={styles.video}
            resizeMode="cover"
            maxBitRate={600000}
            bufferConfig={{
              minBufferMs: 8000,
              maxBufferMs: 25000,
              bufferForPlaybackMs: 1500,
              bufferForPlaybackAfterRebufferMs: 3000,
            }}
            useTextureView={false}
            selectedVideoTrack={{ type: 'resolution', value: 360 } as any}
            paused={!isActive || !isFocused || isPaused}
            muted={false}
            repeat
            playInBackground={false}
            playWhenInactive={false}
            ignoreSilentSwitch="obey"
            controls={false}
            poster={thumbnail || "https://placehold.co/600x800"}
            posterResizeMode="cover"
            onLoadStart={() => setIsBuffering(true)}
            onLoad={handleVideoLoad}
            onProgress={handleProgress}
            onError={handleVideoError}
            onBuffer={(params) => setIsBuffering(params.isBuffering)}
            onEnd={() => onFinishPlaying(index)}
          />
        ) : (
          <View style={styles.errorContainer}>
            <Text style={styles.errorText}>Video unavailable</Text>
            <TouchableOpacity
              style={styles.retryButton}
              onPress={() => setVideoError(false)}
            >
              <Text style={styles.retryText}>Retry</Text>
            </TouchableOpacity>
          </View>
        )}

        {/* 🔇 Fullscreen tap layer for mute/unmute */}
        <Pressable
          style={StyleSheet.absoluteFillObject}
          onPress={handleTap}
        >
          {showPlayPauseIcon && (
            <View style={styles.centerOverlay}>
              <View style={styles.centerCircle}>
                <Ionicons
                  name={isPaused ? "play" : "pause"}
                  size={fw(26)}
                  color="#fff"
                />
              </View>
            </View>
          )}

        </Pressable>

        {/* Buffering indicator */}
        {isBuffering && isActive && (
          <View style={styles.bufferingContainer}>
            <ActivityIndicator size="large" color="#FFFFFF" />
            <Text style={styles.bufferingText}>Loading...</Text>
          </View>
        )}

        <LinearGradient
          pointerEvents="none"
          colors={["transparent", "rgba(0,0,0,0.9)", "rgba(0,0,0,0.9)"]}
          style={styles.bottomGradient}
          start={{ x: 0.5, y: 0 }}
          end={{ x: 0.5, y: 1 }}
        />




        {/* Bottom-left description */}
        <View style={styles.bottomLeftDescription}>
         <TouchableOpacity
  style={styles.chip}
  activeOpacity={0.8}
  onPress={() => {
    if (category_id && onPressCategory) {
     
      onPressCategory(category_id);
    }
  }}
>
  <Text style={styles.chipText}>
    {category?.charAt(0).toUpperCase() + category?.slice(1)}
  </Text>
</TouchableOpacity>





          <Text style={styles.title}>{title}</Text>
          <View>
            <Text style={styles.description}>
              {expanded
                ? description
                : description?.length > 30
                  ? description.slice(0, 40) + "... "
                  : description}
            </Text>
            {description?.length > 30 && (
              <Text
                style={styles.seeMoreLess}
                onPress={() => setExpanded((prev) => !prev)}
              >
                {expanded ? "See less" : "See more"}
              </Text>
            )}
          </View>
        </View>

        {/* Right-side interactions */}
        {isActive && (

          <>

            <View style={styles.OptionsContainer}>
              <InteractionRow
                stats={formattedStats}
                iconSize={fw(28)}
                tintColor="#fff"
                compact
                contentType="videos"
                contentId={video_id}
                deviceId={data?.device_id}
                onComment={onComment}
                onShare={onShare}
                // Handler to receive the like action function
                onProvideLikeAction={(likeFn) => {
                  likeActionRef.current = likeFn;
                }}
                containerStyle={{
                  flexDirection: "column",
                  alignItems: "center",
                  justifyContent: "center",
                  gap: fw(1),
                  marginVertical: fh(-50),
                  right: fw(-3),
                }}
              />
              <TouchableOpacity
                style={styles.tridotWrap}
                onPress={() => setReportVisible(true)}
              >
                <Image
                  source={require("../../../../assets/icons/tridots.png")}
                  style={styles.tridotIcon}
                  resizeMode="contain"
                />
              </TouchableOpacity>
            </View>
          </>
        )}


        {/* Bottom slider */}
        {isActive && duration > 0 && (
          <View style={styles.SliderContainer}>
            {/* <Text style={styles.time}>
              {helper.GetDurationFormat(progress)}
            </Text> */}
            <Slider
              style={{ flex: 1, height: fh(2) }} // thin bar
              minimumValue={0}
              maximumValue={duration}
              value={progress}
              minimumTrackTintColor="#FFFFFF"    // white filled portion
              maximumTrackTintColor="rgba(255,255,255,0.2)" // faint background
              thumbTintColor="transparent"       // hides the thumb
              thumbImage={undefined}             // ensures no default thumb image
              disabled={false}                   // ✅ keep false so progress still updates live
            />

            {/* <Text style={styles.time}>
              {helper.GetDurationFormat(duration)}
            </Text> */}
          </View>
        )}

        <ReportModal
          visible={reportVisible}
          onClose={() => setReportVisible(false)}
          contentId={video_id}
          contentType="videos"
        />
      </View>
    );
  }
);

export default ReelCard;

